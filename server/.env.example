# Server Configuration
PORT=4000

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_here
EMAIL_SECRET=your_email_secret_key_here
MESSAGE_SECRET=your_message_encryption_key_here

# Frontend & Backend URLs
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:4000

# Email Configuration (Resend)
FROM_EMAIL=Chatify <noreply@yourdomain.com>
RESEND_API_KEY=your_resend_api_key_here

# Instructions:
# 1. Copy this file to .env
# 2. Replace all placeholder values with your actual credentials
# 3. Generate secure random strings for JWT_SECRET, EMAIL_SECRET, and MESSAGE_SECRET
# 4. Get your Resend API key from https://resend.com/
# 5. Update FRONTEND_URL and BACKEND_URL if deploying to production
